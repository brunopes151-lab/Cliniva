# Supabase — gerencie as credenciais no painel do Supabase (Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API backend.
# Sem valor, o frontend chama /api no próprio domínio (em dev, o proxy do Vite
# encaminha para localhost:8080). Em produção, com o backend em outro domínio,
# preencha com a URL pública do SEU backend, terminando em /api.
VITE_API_URL=

# Auto-cadastro público de clínica (/cadastro e landing de venda).
# Deixe false numa instalação de uma clínica só. Precisa bater com
# ONBOARDING_PUBLICO_ATIVO do backend.
VITE_CADASTRO_PUBLICO=false
