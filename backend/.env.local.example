# Copie para .env.local e preencha — NÃO versionar .env.local

# Conecte com o usuário dono das tabelas (postgres). A migration
# 20261007000008 liga o RLS em todas as tabelas para fechar a API pública do
# Supabase; o dono das tabelas não é afetado, os outros papéis não leem nada.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<REFF>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USER=postgres
SPRING_DATASOURCE_PASSWORD=<senha-do-banco>

SUPABASE_URL=https://<REFF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
SUPABASE_JWT_SECRET=<legacy_jwt_secret>

CLINIVA_CORS_ORIGIN=http://localhost:5173

# E-mail do administrador da plataforma, criado na subida do backend se ainda
# não existir. Crie a conta com esse e-mail no Supabase (Authentication >
# Users) e entre por /login-admin.
ADMIN_BOOTSTRAP_EMAIL=

# Auto-cadastro público de clínica. false numa instalação de uma clínica só.
ONBOARDING_PUBLICO_ATIVO=false

# ── Resumo do dia com IA (opcional) ──────────────────────────────────────
#
# Sem LLM_PROVIDER o resumo é gerado por template, sem nenhuma chamada
# externa. Isso é o padrão e funciona. Defina provider + chave só se quiser
# o resumo escrito por IA.
#
# LLM_PROVIDER aceita: gemini | groq
#
# Os defaults de modelo abaixo foram conferidos contra a documentação
# oficial em 2026-09-30 e normalmente não precisam ser definidos. Só
# sobrescreva se quiser um modelo específico.
#
#   gemini-3.5-flash-lite  → barato e rápido, bom para resumo curto
#   gemini-3.8-flash       → mais qualidade, mais caro
#   openai/gpt-oss-20b     → Groq, padrão do projeto, $0.075/1M entrada
#   qwen/qwen3.8-27b       → Groq, bom em português, mas ~10x mais caro
#
# Atenção: nem todo modelo da documentação da Groq está acessível para toda
# conta. `llama-3.1-8b-instant` e `llama-3.3-70b-versatile` aparecem na doc
# mas não existiam para a chave deste projeto (`model_not_found`). Confira o
# que a sua chave enxerga antes de trocar:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $CHAVE"
#
# Os `gpt-oss-*` escrevem num campo `reasoning` além do `content`: com
# max_tokens baixo o content vem vazio e o resumo fica em branco sem erro.
# Os 256 tokens do código são suficientes.
#
# LGPD: o resumo manda para o provedor só números agregados do dia (sem nome,
# telefone ou dado de saúde de paciente). Veja ResumoPrompt.java.
#
# Custo no volume do Cliniva (3 clínicas, 5 gerações/dia, 256 tokens de
# resposta): centavos por mês. O que pesa mesmo é a mensalidade fixa de um
# provedor de WhatsApp, não o LLM.

LLM_PROVIDER=
LLM_GEMINI_API_KEY=
#LLM_GEMINI_MODEL=gemini-3.5-flash-lite
LLM_GROQ_API_KEY=
#LLM_GROQ_MODEL=openai/gpt-oss-20b